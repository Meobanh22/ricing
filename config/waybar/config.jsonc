{
  "layer": "top",
  "position": "top",
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 8,

  "modules-left": [
    "clock",
    "custom/media"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "custom/ime",
    "pulseaudio",
    "network",
    "battery",
    "custom/notification",
    "custom/power"
  ],

  "custom/menu": {
    "format": "<span color='#DC1A36'>✿</span> <span color='#FFF0F5'><b>Apps</b></span>",
    "tooltip": "Application Menu (Super + Space)",
    "on-click": "~/.config/hypr/scripts/system/OpenApps.sh"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "format": "{name}",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "custom/media": {
    "format": "{}",
    "return-type": "json",
    "exec": "python3 ~/.config/hypr/scripts/system/get_media.py",
    "interval": 1,
    "on-click": "bash ~/.config/hypr/scripts/popups/toggle_music.sh",
    "on-click-right": "playerctl play-pause",
    "on-click-middle": "playerctl next",
    "escape": true
  },

  "clock": {
    "format": "<span color='#DC1A36'></span> <span color='#FFF0F5'><b>{0:%H:%M}</b></span>  <span color='#DC1A36'>·</span>  <span color='#E8C2D0'>{0:%d/%m}</span>",
    "format-alt": "<span color='#DC1A36'></span> <span color='#FFF0F5'><b>{0:%H:%M:%S}</b></span>  <span color='#DC1A36'>·</span>  <span color='#E8C2D0'>{0:%A, %d/%m/%Y}</span>",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "tooltip": "Calendar"
  },

  "custom/ime": {
    "exec": "~/.config/hypr/scripts/system/get_ime.sh",
    "interval": 1,
    "format": "{}",
    "tooltip": "Input Method VIE / ENG (Ctrl + Shift or Super + Shift + Space)",
    "on-click": "~/.config/hypr/scripts/system/toggle_vietnamese.sh"
  },

  "pulseaudio": {
    "format": "<span font='14.5px' color='#DC1A36'>{icon}</span> {volume}%",
    "format-muted": "<span font='14.5px' color='#A68595'>󰖁</span> Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋋",
      "headset": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "max-volume": 100,
    "scroll-step": 5,
    "tooltip-format": "Volume: {volume}%\n(Click: Pavucontrol | Right-click: Control Center)",
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/hypr/scripts/popups/toggle_control_center.sh"
  },

  "network": {
    "format-wifi": "<span color='#DC1A36'>󰖩</span> {essid}",
    "format-ethernet": "<span color='#DC1A36'>󰈀</span> Wired",
    "format-disconnected": "<span color='#A68595'>󰖪</span> Offline",
    "tooltip-format": "Wi-Fi: {essid} ({signalStrength}%)\n(Click: Network Settings | Right-click: Control Center)",
    "on-click": "nm-connection-editor",
    "on-click-right": "~/.config/hypr/scripts/popups/toggle_control_center.sh"
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "<span color='#DC1A36'>{icon}</span> {capacity}%",
    "format-charging": "<span color='#DC1A36'>󰂄</span> {capacity}%",
    "format-plugged": "<span color='#DC1A36'>󰚥</span> {capacity}%",
    "format-alt": "<span color='#DC1A36'>{icon}</span> {time}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Battery: {capacity}% ({time})\n(Right-click: Control Center)",
    "on-click-right": "~/.config/hypr/scripts/popups/toggle_control_center.sh"
  },

  "custom/notification": {
    "format": "<span color='#DC1A36'>󰂚</span>",
    "tooltip": "Left-click: Control Center (Super + N)\nRight-click: Settings (Super + P)",
    "on-click": "~/.config/hypr/scripts/popups/toggle_control_center.sh",
    "on-click-right": "~/.config/hypr/scripts/popups/toggle_settings.sh"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": "Power Menu (Click to open)",
    "on-click": "~/.config/hypr/scripts/system/Wlogout.sh"
  }
}
