/* config.rasi — Rofi application launcher theme in Tactile 3D Anime Style. */

@import "colors-rofi.rasi"

* {
    font: "JetBrains Mono Nerd Font 13";
    background-color: transparent;
    width: 640px;
}

window {
    height: 480px;
    border: 2px 2px 6px 2px;
    border-color: @border-waybar-3d;
    border-radius: 18px;
    background-color: @bg-tactile-cream;
    padding: 16px;
}

mainbox {
    background-color: transparent;
    spacing: 12px;
}

inputbar {
    children: [prompt, entry];
    background-color: rgba(255, 255, 255, 0.85);
    border: 1.5px 1.5px 3.5px 1.5px;
    border-color: @border-waybar-3d;
    border-radius: 11px;
    padding: 6px 12px;
}

prompt {
    background-color: @accent;
    padding: 6px 14px;
    text-color: @text-inverse;
    border-radius: 8px;
    margin: 0px 8px 0px 0px;
    font-weight: bold;
}

entry {
    padding: 6px;
    text-color: @bg-waybar;
    placeholder: "Search applications...";
    placeholder-color: @text-muted;
    font-weight: 600;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 8px 0px 0px 0px;
    columns: 2;
    lines: 6;
    background-color: transparent;
    spacing: 8px;
}

element {
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.50);
    text-color: @bg-waybar;
    border-radius: 10px;
    border: 1px 1px 2px 1px;
    border-color: transparent;
}

element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color: rgba(255, 255, 255, 0.50);
    text-color: @bg-waybar;
    border-color: transparent;
}

element-icon {
    size: 26px;
    margin: 0 10px 0 0;
    background-color: inherit;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
    font-weight: 700;
}

element selected.normal, element selected {
    background-color: @text-inverse;
    border: 1.5px 1.5px 3.5px 1.5px;
    border-color: @border-waybar-3d;
    text-color: @accent;
}

element selected.urgent {
    background-color: @text-inverse;
    border: 1.5px 1.5px 3.5px 1.5px;
    border-color: @accent;
    text-color: @accent;
}

element selected.active {
    background-color: @text-inverse;
    border: 1.5px 1.5px 3.5px 1.5px;
    border-color: @border-waybar-3d;
    text-color: @accent;
}
