/* config.rasi — Rofi application launcher theme. */

@import "colors-rofi.rasi"

* {
    font: "JetBrains Mono Nerd Font 13";
    background-color: transparent;
    width: 640px;
}

window {
    height: 470px;
    border: 1px;
    border-color: @border-window;
    border-radius: 16px;
    background-color: @bg-window;
    padding: 16px;
}

mainbox {
    background-color: transparent;
    spacing: 12px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-card;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px 12px;
}

prompt {
    background-color: @accent;
    padding: 6px 14px;
    text-color: @text-inverse;
    border-radius: 8px;
    margin: 0px 8px 0px 0px;
    font-weight: bold;
}

entry {
    padding: 6px;
    text-color: @text-primary;
    placeholder: "Search applications...";
    placeholder-color: @text-muted;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 8px 0px 0px 0px;
    columns: 2;
    lines: 6;
    background-color: transparent;
    spacing: 6px;
}

element {
    padding: 8px 10px;
    background-color: transparent;
    text-color: @text-secondary;
    border-radius: 8px;
}

element-icon {
    size: 26px;
    margin: 0 10px 0 0;
    background-color: inherit;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
    font-weight: 600;
}

element selected.normal, element selected {
    background-color: @bg-card-hover;
    border: 1px;
    border-color: @border-card-hover;
    text-color: @text-primary;
}

element selected.urgent {
    background-color: @bg-card-hover;
    border: 1px;
    border-color: @status-warning;
    text-color: @status-warning;
}

element selected.active {
    background-color: @bg-card-hover;
    border: 1px;
    border-color: @border-card-hover;
    text-color: @accent;
}
