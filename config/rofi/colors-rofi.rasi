/* colors-rofi.rasi — Color, typography and geometry tokens for Rofi. */
/* NOTE: Generated from tokens.json. Do not edit directly. */

* {
    bg-window:          rgba(32, 16, 17, 0.98);
    bg-card:            rgba(42, 26, 30, 0.95);
    bg-card-hover:      rgba(58, 34, 42, 0.98);
    bg-subtle:          rgba(48, 31, 32, 0.95);
    bg-ghost:           transparent;
    bg-ghost-hover:     rgba(42, 26, 30, 0.50);

    border-window:      rgba(255, 255, 255, 0.12);
    border-card:        rgba(255, 255, 255, 0.12);
    border-card-hover:  rgba(220, 26, 54, 0.65);

    accent:             #DC1A36;
    accent-hover:       #F02D4C;
    text-primary:       #FFF0F5;
    text-secondary:     #E8C2D0;
    text-muted:         #A68595;
    text-inverse:       #FFFFFF;
    text-white:         #FFFFFF;

    status-warning:     #FFB86C;
    status-critical:    #DC1A36;
    status-success:     #8FBC8F;

    ribbon-blue:        #50A6FF;
    screen-cyan:        #87F0FF;
    bg-tactile-cream:   rgba(255, 240, 245, 0.96);
    pokepuff-pink:      #FF5C8A;
    bg-waybar:          #851733;
    border-waybar-3d:   #4D0A1C;
    shadow-extrusion:   #4D0A1C;

    font-primary:       "JetBrains Mono Nerd Font 13";
    width-rofi:         640px;
    radius-window:      16px;
    radius-card:        10px;
    radius-button:      8px;
}
