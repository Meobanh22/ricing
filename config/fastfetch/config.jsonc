{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/sylveon_chibi.txt",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " ✿ ",
    "color": {
      "keys": "#DC1A36",
      "title": "#F02D4C",
      "separator": "#E8C2D0",
      "output": "#FFF0F5"
    },
    "percent": {
      "color": {
        "green": "#50A6FF",
        "yellow": "#F02D4C",
        "red": "#DC1A36"
      }
    },
    "bar": {
      "color": {
        "elapsed": "#DC1A36",
        "total": "#3A222A",
        "border": "#A68595"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "✿ {user-name-colored} @ {host-name-colored} ✿"
    },
    {
      "type": "separator",
      "string": "┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈",
      "outputColor": "#A68595"
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "host",
      "key": "󰌢 Host"
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "format": "Intel i5-1135G7 ({4}) @ {7}"
    },
    {
      "type": "gpu",
      "key": "󰾲 GPU",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": " Disk",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "battery",
      "key": " Battery",
      "format": "{4} [{5}]"
    },
    {
      "type": "separator",
      "string": "┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈",
      "outputColor": "#A68595"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
