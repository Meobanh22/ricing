/* ==============================================================================
   🌸 SERENA & FENNEKIN ROFI FLAT LAUNCHER THEME
   Clean Flat UI: Thin borders, flat surfaces, zero harsh shadows, unified palette.
   Colors: Serena Crimson (#C82A2B), Midnight Dusk (#161726), Warm Ivory (#FFF1D4)
   ============================================================================== */

configuration {
    modi: "drun,run,filebrowser";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "🌸 Apps";
    display-run: "⚡ Run";
    display-filebrowser: "📁 Files";
    drun-display-format: "{name}";
}

* {
    bg-col:             #161726f4;
    bg-col-light:       #1c1d30;
    border-col:         #2e3048;
    selected-col:       #c82a2b;
    crimson-hover:      #db3b32;
    fg-col:             #fff1d4;
    fg-secondary:       #b4a5d0;
    fg-muted:           #757091;
    fg-white:           #ffffff;

    background-color: transparent;
    width: 640px;
}

window {
    height: 460px;
    border: 1px;
    border-color: @border-col;
    border-radius: 16px;
    background-color: @bg-col;
    padding: 16px;
}

mainbox {
    background-color: transparent;
    spacing: 12px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col-light;
    border: 1px;
    border-color: @border-col;
    border-radius: 12px;
    padding: 8px 12px;
}

prompt {
    background-color: @selected-col;
    padding: 6px 12px;
    text-color: @fg-white;
    border-radius: 8px;
    margin: 0px 8px 0px 0px;
    font-weight: bold;
}

entry {
    padding: 6px;
    text-color: @fg-col;
    placeholder: "Tìm kiếm ứng dụng...";
    placeholder-color: @fg-muted;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 8px 0px 0px 0px;
    columns: 2;
    lines: 6;
    background-color: transparent;
    spacing: 6px;
}

element {
    padding: 8px 12px;
    background-color: transparent;
    text-color: @fg-secondary;
    border-radius: 10px;
}

element-icon {
    size: 26px;
    margin: 0 10px 0 0;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    font-weight: 600;
}

element selected {
    background-color: @selected-col;
    text-color: @fg-white;
}
