/* ==============================================================================
   🌸 SERENA ROFI MINIMALIST APP LAUNCHER
   Clean Flat UI: Neutral outer border, obsidian-wine background, ribbon red accents.
   ============================================================================== */

configuration {
    modi: "drun,run,filebrowser";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "🌸 Apps";
    display-run: "⚡ Run";
    display-filebrowser: "📁 Files";
    drun-display-format: "{name}";
}

* {
    bg-col:             #201011f5;
    bg-col-light:       #2A1A1E;
    bg-hover:           #3A222A;
    border-col:         rgba(255, 255, 255, 0.08);
    border-subtle:      rgba(255, 42, 85, 0.25);
    selected-col:       #FF2A55;
    crimson-hover:      #FF597B;
    urgent-col:         #E65E34;
    fg-col:             #FFF0F5;
    fg-secondary:       #E8C2D0;
    fg-muted:           #A68595;
    fg-white:           #FFFFFF;

    background-color: transparent;
    width: 640px;
}

window {
    height: 470px;
    border: 1px;
    border-color: @border-col;
    border-radius: 16px;
    background-color: @bg-col;
    padding: 16px;
}

mainbox {
    background-color: transparent;
    spacing: 12px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col-light;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 12px;
    padding: 8px 12px;
}

prompt {
    background-color: @selected-col;
    padding: 6px 14px;
    text-color: @fg-white;
    border-radius: 8px;
    margin: 0px 8px 0px 0px;
    font-weight: bold;
}

entry {
    padding: 6px;
    text-color: @fg-col;
    placeholder: "Tìm kiếm ứng dụng...";
    placeholder-color: @fg-muted;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 8px 0px 0px 0px;
    columns: 2;
    lines: 6;
    background-color: transparent;
    spacing: 6px;
}

element {
    padding: 8px 12px;
    background-color: transparent;
    text-color: @fg-secondary;
    border-radius: 10px;
}

element-icon {
    size: 26px;
    margin: 0 10px 0 0;
    background-color: inherit;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
    font-weight: 600;
}

element selected.normal, element selected {
    background-color: @selected-col;
    text-color: @fg-white;
}

element selected.urgent {
    background-color: @urgent-col;
    text-color: @fg-white;
}

element selected.active {
    background-color: @crimson-hover;
    text-color: @fg-white;
}
