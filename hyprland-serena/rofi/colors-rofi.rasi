* {
    bg-window:          rgba(32, 16, 18, 0.98);
    bg-card:            rgba(42, 26, 31, 0.95);
    bg-card-hover:      rgba(58, 34, 42, 0.98);
    bg-subtle:          rgba(48, 31, 32, 0.95);
    bg-ghost:           transparent;
    bg-ghost-hover:     rgba(42, 26, 31, 0.50);

    border-window:      rgba(255, 255, 255, 0.12);
    border-card:        rgba(255, 255, 255, 0.12);
    border-card-hover:  rgba(255, 42, 85, 0.65);

    accent:             #FF2A55;
    accent-hover:       #FF597B;
    text-primary:       #FFF0F5;
    text-secondary:     #E8C2D0;
    text-muted:         #A68595;
    text-inverse:       #FFFFFF;
    text-white:         #FFFFFF;

    status-warning:     #FFB86C;
    status-critical:    #FF2A55;
    status-success:     #8FBC8F;

    ribbon-blue:        #50A6FF;
}
