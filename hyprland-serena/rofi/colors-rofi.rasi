/* ==============================================================================
   🌸 SERENA & FENNEKIN ROFI COLOR PALETTE (WINE & CRIMSON)
   Extracted from Serena & Fennekin Desktop Theme
   ============================================================================== */

* {
    /* Deep Wine & Ruby Containers */
    bg-col:             #160810f4;
    bg-col-light:       #1f0c17;
    bg-surface-hover:   #2a101f;
    border-col:         #e12d4b55;
    border-focus:       #e63956;

    /* Internal Component Accents */
    crimson-accent:     #c82a2b;
    crimson-hover:      #db3b32;
    pink-accent:        #ff6b8b;
    amber-accent:       #e59a44;
    lavender-accent:    #caaab8;
    dusk-blue-accent:   #7772c2;

    /* Text & Foreground */
    fg-col:             #fff0f3;
    fg-secondary:       #caaab8;
    fg-muted:           #8f7481;
    fg-white:           #ffffff;

    /* Selection & Urgency */
    selected-col:       #c82a2b;
    urgent-col:         #e65e34;
}
