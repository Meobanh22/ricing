# ==============================================================================
# 🌸 OFFICIAL RIBBON BTOP THEME
# Locked Palette: Warm Obsidian-Wine & Ribbon Red System
# Background: #201011 | Ribbon Red Accent: #FF2A55 | Rose Ivory: #FFF0F5
# ==============================================================================

# Main background and foreground
theme[main_bg]="#201011"
theme[main_fg]="#FFF0F5"
theme[title]="#FF2A55"
theme[hi_fg]="#FF597B"

# Selected items
theme[selected_bg]="#FF2A55"
theme[selected_fg]="#FFFFFF"

# Inactive items
theme[inactive_fg]="#A68595"

# Graph text & miscellaneous
theme[graph_text]="#E8C2D0"
theme[meter_bg]="#2A1A1E"
theme[proc_misc]="#FF597B"

# Box borders (Neutral border & Ribbon Red highlights)
theme[cpu_box]="#FF2A55"
theme[mem_box]="#E59A44"
theme[net_box]="#7772C2"
theme[proc_box]="#FF597B"
theme[div_line]="#3A222A"

# Temperature gradient (Sage -> Amber -> Ribbon Red)
theme[temp_start]="#7FA873"
theme[temp_mid]="#E59A44"
theme[temp_end]="#FF2A55"

# CPU gradient (Lavender-Rose -> Coral -> Ribbon Red)
theme[cpu_start]="#E8C2D0"
theme[cpu_mid]="#FF597B"
theme[cpu_end]="#FF2A55"

# Memory gradients
theme[free_start]="#7FA873"
theme[free_mid]="#98BD8D"
theme[free_end]="#B7823C"

theme[cached_start]="#7772C2"
theme[cached_mid]="#E8C2D0"
theme[cached_end]="#FFF0F5"

theme[available_start]="#7FA873"
theme[available_mid]="#E59A44"
theme[available_end]="#FF597B"

theme[used_start]="#E8C2D0"
theme[used_mid]="#FF597B"
theme[used_end]="#FF2A55"

# Network gradients (Dusk / Lavender -> Coral / Ribbon Red)
theme[download_start]="#7772C2"
theme[download_mid]="#E8C2D0"
theme[download_end]="#FF597B"

theme[upload_start]="#A68595"
theme[upload_mid]="#FF597B"
theme[upload_end]="#FF2A55"

# Process list gradients
theme[process_start]="#E8C2D0"
theme[process_mid]="#FF597B"
theme[process_end]="#FF2A55"
