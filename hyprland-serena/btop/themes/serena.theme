# ==============================================================================
# 🌸 SERENA & FENNEKIN BTOP THEME (FLAT UI)
# Extracted directly from serena_fennekin_wallpaper_hd.jpg
# Colors: Serena Crimson (#C82A2B), Amber (#E59A44), Midnight (#161726)
# ==============================================================================

# Main background and foreground
theme[main_bg]="#161726"
theme[main_fg]="#FFF1D4"
theme[title]="#C82A2B"
theme[hi_fg]="#E59A44"

# Selected items
theme[selected_bg]="#C82A2B"
theme[selected_fg]="#FFFFFF"

# Inactive items
theme[inactive_fg]="#757091"

# Graph text & miscellaneous
theme[graph_text]="#B4A5D0"
theme[meter_bg]="#202135"
theme[proc_misc]="#E59A44"

# Box borders
theme[cpu_box]="#C82A2B"
theme[mem_box]="#E59A44"
theme[net_box]="#5E5BAA"
theme[proc_box]="#88293F"
theme[div_line]="#2E3048"

# Temperature gradient (Amber Fur -> Warm Crimson)
theme[temp_start]="#B7823C"
theme[temp_mid]="#E59A44"
theme[temp_end]="#C82A2B"

# CPU gradient (Amber Fur -> Warm Crimson)
theme[cpu_start]="#B7823C"
theme[cpu_mid]="#E59A44"
theme[cpu_end]="#C82A2B"

# Memory gradients (Sage Foliage -> Amber -> Crimson)
theme[free_start]="#7FA873"
theme[free_mid]="#98BD8D"
theme[free_end]="#B7823C"

theme[cached_start]="#5E5BAA"
theme[cached_mid]="#7772C2"
theme[cached_end]="#B4A5D0"

theme[available_start]="#7FA873"
theme[available_mid]="#B7823C"
theme[available_end]="#E59A44"

theme[used_start]="#B7823C"
theme[used_mid]="#E59A44"
theme[used_end]="#C82A2B"

# Network gradients (Dusk Indigo -> Twilight Sky)
theme[download_start]="#5E5BAA"
theme[download_mid]="#7772C2"
theme[download_end]="#B4A5D0"

theme[upload_start]="#88293F"
theme[upload_mid]="#C82A2B"
theme[upload_end]="#DB3B32"

# Process list gradients
theme[process_start]="#B7823C"
theme[process_mid]="#E59A44"
theme[process_end]="#C82A2B"
