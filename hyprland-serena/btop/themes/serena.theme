# ==============================================================================
# 🌸 SERENA & SYLVEON THEME FOR BTOP
# Colors: Serena Crimson (#E53935), Ribbon Rose (#FF6B8B), Sylveon Blue (#61B8FF)
# ==============================================================================

# Main background and foreground
theme[main_bg]="#181825"
theme[main_fg]="#FFFFFF"
theme[title]="#FF6B8B"
theme[hi_fg]="#FF8A80"

# Selected items
theme[selected_bg]="#E53935"
theme[selected_fg]="#FFFFFF"

# Inactive items
theme[inactive_fg]="#585B70"

# Graph text & miscellaneous
theme[graph_text]="#BAC2DE"
theme[meter_bg]="#313244"
theme[proc_misc]="#FFB74D"

# Box borders (Serena Red & Sylveon Accents)
theme[cpu_box]="#E53935"
theme[mem_box]="#FF6B8B"
theme[net_box]="#61B8FF"
theme[proc_box]="#F06292"
theme[div_line]="#45475A"

# Temperature gradient (Honey Amber -> Rose -> Serena Red)
theme[temp_start]="#FFB74D"
theme[temp_mid]="#FF6B8B"
theme[temp_end]="#E53935"

# CPU gradient (Honey Amber -> Ribbon Rose -> Serena Red)
theme[cpu_start]="#FFB74D"
theme[cpu_mid]="#FF6B8B"
theme[cpu_end]="#E53935"

# Memory gradients
theme[free_start]="#A6E3A1"
theme[free_mid]="#94E2D5"
theme[free_end]="#61B8FF"

theme[cached_start]="#61B8FF"
theme[cached_mid]="#89DCEB"
theme[cached_end]="#F5C2E7"

theme[available_start]="#BAC2DE"
theme[available_mid]="#FFCDD2"
theme[available_end]="#FF8A80"

theme[used_start]="#FFB74D"
theme[used_mid]="#FF6B8B"
theme[used_end]="#E53935"

# Network gradients (Sylveon Sky Blue to Rose)
theme[download_start]="#61B8FF"
theme[download_mid]="#89B4FA"
theme[download_end]="#F5C2E7"

theme[upload_start]="#F5C2E7"
theme[upload_mid]="#FF6B8B"
theme[upload_end]="#E53935"

# Process list gradients
theme[process_start]="#FFB74D"
theme[process_mid]="#FF6B8B"
theme[process_end]="#E53935"
