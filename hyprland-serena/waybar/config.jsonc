{
  "layer": "top",
  "position": "top",
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 8,

  "modules-left": [
    "custom/menu",
    "hyprland/workspaces",
    "custom/media"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "custom/ime",
    "pulseaudio",
    "network",
    "battery",
    "custom/notification",
    "custom/power"
  ],

  "custom/menu": {
    "format": "<span color='#ff2a55'>🌸</span> <span color='#fff0f5'><b>SERENA</b></span> <span color='#ff2a55'>🌸</span>",
    "tooltip": "Application Menu (Super + D)",
    "on-click": "rofi -show drun -theme ~/.config/rofi/serena.rasi"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "format": "{name}",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "custom/media": {
    "format": "{}",
    "return-type": "json",
    "exec": "bash ~/.config/hypr/scripts/get_media.sh",
    "interval": 1,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "escape": true
  },

  "clock": {
    "format": "<span color='#ff2a55'></span> <span color='#fff0f5'><b>{0:%H:%M}</b></span>  <span color='#ff2a55'>·</span>  <span color='#e8c2d0'>{0:%d/%m}</span>",
    "format-alt": "<span color='#ff2a55'></span> <span color='#fff0f5'><b>{0:%H:%M:%S}</b></span>  <span color='#ff2a55'>·</span>  <span color='#e8c2d0'>{0:%A, %d/%m/%Y}</span>",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "tooltip": "Calendar & Dashboard (Super + C)",
    "on-click": "python3 ~/.config/hypr/scripts/serena_dashboard.py"
  },

  "custom/ime": {
    "exec": "~/.config/hypr/scripts/get_ime.sh",
    "interval": 1,
    "format": "{}",
    "tooltip": "Input Method VIE / ENG (Click to toggle)",
    "on-click": "~/.config/hypr/scripts/toggle_vietnamese.sh"
  },

  "pulseaudio": {
    "format": "<span color='#ff2a55'>{icon}</span> {volume}%",
    "format-muted": "<span color='#a68595'>󰖁</span> Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋋",
      "headset": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "Volume: {volume}%\n(Click: Pavucontrol | Right-click: Control Center)",
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/hypr/scripts/toggle_control_center.sh"
  },

  "network": {
    "format-wifi": "<span color='#ff2a55'>󰖩</span> {essid}",
    "format-ethernet": "<span color='#ff2a55'>󰈀</span> Wired",
    "format-disconnected": "<span color='#a68595'>󰖪</span> Offline",
    "tooltip-format": "Wi-Fi: {essid} ({signalStrength}%)\n(Click: Network Settings | Right-click: Control Center)",
    "on-click": "nm-connection-editor",
    "on-click-right": "~/.config/hypr/scripts/toggle_control_center.sh"
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "<span color='#ff2a55'>{icon}</span> {capacity}%",
    "format-charging": "<span color='#ff2a55'>󰂄</span> {capacity}%",
    "format-plugged": "<span color='#ff2a55'>󰚥</span> {capacity}%",
    "format-alt": "<span color='#ff2a55'>{icon}</span> {time}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Battery: {capacity}% ({time})\n(Right-click: Control Center)",
    "on-click-right": "~/.config/hypr/scripts/toggle_control_center.sh"
  },

  "custom/notification": {
    "format": "<span color='#ff2a55'>󰂚</span>",
    "tooltip": "Control Center & Notifications (Super + N)",
    "on-click": "~/.config/hypr/scripts/toggle_control_center.sh",
    "on-click-right": "~/.config/hypr/scripts/toggle_control_center.sh"
  },

  "custom/power": {
    "format": "<span color='#ff2a55'></span>",
    "tooltip": "Power Menu (Click to open)",
    "on-click": "~/.config/hypr/scripts/Wlogout.sh"
  }
}
