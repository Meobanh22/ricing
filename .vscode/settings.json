{
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "none",
        "reportMissingModuleSource": "none"
    },
    "python.analysis.extraPaths": [
        "/usr/lib/python3/dist-packages",
        "/usr/local/lib/python3.12/dist-packages"
    ],
    "css.validate": false,
    "scss.validate": false,
    "less.validate": false,
    "css.lint.unknownAtRules": "ignore",
    "less.lint.unknownAtRules": "ignore",
    "scss.lint.unknownAtRules": "ignore",
    "css.lint.validProperties": [
        "-gtk-*"
    ],
    "files.associations": {
        "*.rasi": "css",
        "config": "jsonc",
        "*.theme": "ini"
    },
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.gpuAcceleration": "on",
    "workbench.colorCustomizations": {
        "terminal.background": "#201011",
        "terminal.foreground": "#FFF0F5",
        "terminal.selectionBackground": "#FF2A554D",
        "terminal.selectionForeground": "#FFFFFF",
        "terminalCursor.foreground": "#FF2A55",
        "terminalCursor.background": "#201011",
        "terminal.ansiBlack": "#201011",
        "terminal.ansiBrightBlack": "#3A222A",
        "terminal.ansiRed": "#FF2A55",
        "terminal.ansiBrightRed": "#FF597B",
        "terminal.ansiGreen": "#50A6FF",
        "terminal.ansiBrightGreen": "#60A5FA",
        "terminal.ansiYellow": "#FFB86C",
        "terminal.ansiBrightYellow": "#FBBF24",
        "terminal.ansiBlue": "#50A6FF",
        "terminal.ansiBrightBlue": "#60A5FA",
        "terminal.ansiMagenta": "#E8C2D0",
        "terminal.ansiBrightMagenta": "#F7CAD7",
        "terminal.ansiCyan": "#50A6FF",
        "terminal.ansiBrightCyan": "#A68595",
        "terminal.ansiWhite": "#FFF0F5",
        "terminal.ansiBrightWhite": "#FFFFFF"
    }
}
