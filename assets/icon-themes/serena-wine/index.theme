[Icon Theme]
Name=Serena Wine
Comment=Serena Wine red folder and media icons inheriting Adwaita
Inherits=Adwaita,AdwaitaLegacy,hicolor
Example=folder

Directories=16x16/places,16x16/mimetypes,16x16/actions,scalable/places,scalable/mimetypes,scalable/actions

[16x16/places]
Context=Places
Size=16
Type=Fixed

[16x16/mimetypes]
Context=MimeTypes
Size=16
Type=Fixed

[16x16/actions]
Context=Actions
Size=16
Type=Fixed

[scalable/places]
Context=Places
Size=128
MinSize=24
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=128
MinSize=24
MaxSize=512
Type=Scalable

[scalable/actions]
Context=Actions
Size=128
MinSize=24
MaxSize=512
Type=Scalable
