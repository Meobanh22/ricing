{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/sylveon_chibi.txt",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 🌸 ",
    "color": {
      "keys": "red",
      "title": "light_red"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "🌸 {user-name-colored} @ {host-name-colored} 🌸"
    },
    {
      "type": "separator",
      "string": "┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈"
    },
    {
      "type": "os",
      "key": " OS",
      "format": "{2} {9} LTS"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "format": "HP Pavilion x360"
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "format": "Intel i5-1135G7 ({4}) @ {7}"
    },
    {
      "type": "gpu",
      "key": "󰾲 GPU",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": " Disk",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "battery",
      "key": " Battery",
      "format": "{4} [{5}]"
    },
    {
      "type": "separator",
      "string": "┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
