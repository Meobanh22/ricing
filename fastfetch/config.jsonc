{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/sylveon_chibi.txt",
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " 🌸 ",
    "color": {
      "keys": "magenta",
      "title": "cyan"
    },
    "percent": {
      "type": 3
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "□"
      },
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "🌸 {user-name-colored} @ {host-name-colored} 🌸"
    },
    {
      "type": "separator",
      "string": "┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈"
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "host",
      "key": "󰌢 Host"
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "󰾲 GPU"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory"
    },
    {
      "type": "disk",
      "key": " Disk (C:)",
      "folders": "C:/"
    },
    {
      "type": "battery",
      "key": " Battery"
    },
    {
      "type": "separator",
      "string": "┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
